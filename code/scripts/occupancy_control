#!/usr/bin/env python3
# Occupancy control based on shifting chemical potential mu to match the density computed through lattice GF
# Rok Zitko, rok.zitko@ijs.si, 2025-2026

import argparse
from pathlib import Path
import shlex
import subprocess

import numpy as np
import pandas as pd
from scipy.interpolate import interp1d
from scipy.integrate import quad
from scipy.optimize import root_scalar


parser = argparse.ArgumentParser(description="DMFT occupancy control")
parser.add_argument(
    "--measure-only",
    action="store_true",
    help="measure and optionally record occupancy without changing param.mu",
)
parser.add_argument(
    "--history",
    action="store_true",
    help="write <history-dir>/<iteration>-mu-occup.dat for Broyden control",
)
parser.add_argument(
    "--spectrum",
    type=Path,
    default=Path("res/imaw.dat"),
    help="spectrum file (default: res/imaw.dat)",
)
parser.add_argument(
    "--mu-input",
    type=Path,
    default=Path("param.mu"),
    help="chemical-potential input file (default: param.mu)",
)
parser.add_argument(
    "--mu-output",
    type=Path,
    default=Path("param.mu"),
    help="chemical-potential output file (default: param.mu)",
)
parser.add_argument(
    "--log",
    type=Path,
    default=Path("occupancy.log"),
    help="occupancy log file (default: occupancy.log)",
)
parser.add_argument(
    "--iteration",
    type=int,
    help="iteration number for --history (default: getiter output)",
)
parser.add_argument(
    "--history-dir",
    type=Path,
    default=Path("dmft"),
    help="occupancy history directory (default: dmft)",
)
args = parser.parse_args()


def get_float(command, default=None):
    command = shlex.split(command)
    try:
        result = subprocess.run(
            command,
            capture_output=True,
            text=True,
            check=True
        )
        return float(result.stdout.strip())
    except (subprocess.CalledProcessError, ValueError):
        return default


def require_output_parent(path):
    if not path.parent.is_dir():
        raise RuntimeError(
            f"Output directory for {path} does not exist or is not a directory: "
            f"{path.parent}"
        )


T = get_float("getparam T param.loop")
LIM = get_float("getparam broaden_max param.loop")
GOAL = get_float("getparam goal param.loop")
MAXDX = get_float("getparam maxdx param.loop")
UNDER = get_float("getparam under param.loop", 0.5)

oldmu = float(args.mu_input.read_text(encoding="ascii").strip())

print(f"T={T} lim={LIM} goal={GOAL} maxdx={MAXDX} oldmu={oldmu}\n")

# --- Load data ---
data = pd.read_csv(args.spectrum, sep=r"\s+", header=None)
x_vals, y_vals = data[0].values, data[1].values
A = interp1d(x_vals, y_vals, kind='cubic', fill_value="extrapolate")
print("A(0) =", A(0))

# --- Fermi function ---
def f(w):
    return 1 / (1 + np.exp(w / T))

# --- Total integral of A(w) ---
total, _ = quad(lambda w: A(w), -LIM, LIM, limit=1000)
print("total =", total)

# --- Integration bounds for shifted integral ---
LIM1 = -LIM
LIM2 = min(LIM, 40*T)

# --- Occupancy function ---
def n(shift):
    def integrand(w):
        return A(w - shift) * f(w)
    result, _ = quad(integrand, LIM1, LIM2, limit=1000)
    return 2 * result  # Factor of 2 for spin

n0 = n(0)
print("n[shift=0] =", n0)

if args.history:
    iteration = args.iteration
    if iteration is None:
        result = subprocess.run(
            ["getiter"],
            capture_output=True,
            text=True,
            check=True,
        )
        iteration = int(result.stdout.strip())
    if not args.history_dir.is_dir():
        raise RuntimeError(
            f"{args.history_dir} does not exist or is not a directory; "
            "occupancy history requires track=true"
        )
    history_file = args.history_dir / f"{iteration}-mu-occup.dat"
    temporary = history_file.with_name(f".{history_file.name}.tmp")
    temporary.write_text(f"{oldmu:.17g} {n0:.17g}\n", encoding="ascii")
    temporary.replace(history_file)
    print("occupancy history =", history_file)

if args.measure_only:
    print(f"Measurement-only mode: {args.mu_output} was not changed.")
    raise SystemExit(0)

require_output_parent(args.mu_output)
require_output_parent(args.log)

# --- Solve for shift such that n(shift) == GOAL ---
sol = root_scalar(lambda shift: n(shift) - GOAL, x0=0, method='secant')
shift = sol.root
print("sol =", sol)

shift = UNDER * shift # "underrelaxation"

newmu = oldmu - shift

print("oldmu =", oldmu)
print("newmu =", newmu)

# --- Clip dx if too large ---
dx = newmu - oldmu
print("dx =", dx)
if abs(dx) > MAXDX:
    dx = np.sign(dx) * MAXDX
    print("Clipping. dx==", dx)

newmu = oldmu + dx

# --- Write to files ---
args.mu_output.write_text(f"{newmu}\n", encoding="ascii")

with args.log.open("a", encoding="ascii") as output:
    output.write(f"{oldmu} {newmu} {dx} {n0}\n")
