#!/usr/bin/env perl
# Finalize one DMFT cycle through a restartable res/ staging directory.
# Rok Zitko, 2008-2026

use strict;
use warnings;
use File::Compare qw(compare);
use File::Copy qw(copy);
use File::Path qw(remove_tree);
use Getopt::Long qw(GetOptions);
use List::Util qw(max);
use POSIX qw(isfinite);
use Term::ANSIColor qw(:constants colored);

my $publish_only = 0;
my ($cached_delta_clip, $cached_delta_eps);
my $stage_validated = 0;
GetOptions("publish" => \$publish_only) or die "Usage: $0 [--publish]\n";

if (-e "res/READY" || -e "res/READY.complete") {
    if (recover_ready_marker()) {
        publish_ready();
        exit 0;
    }
    $publish_only and die "No valid ready transaction found in res/.\n";
    warn "Discarding an incomplete staging directory without a valid READY marker.\n";
}
$publish_only and die "No ready transaction found in res/.\n";

my $mesh_refinement = 1;
chomp(my $Nz = `getparam Nz param.loop`);
$Nz =~ /\A\d+\z/ && $Nz >= 1 or die "Invalid Nz=$Nz\n";

chomp(my $mixing = `getparam mixing param.loop 2>/dev/null`);
$mixing = "linear" if $mixing eq "";
$mixing = lc($mixing);
($mixing eq "linear" || $mixing eq "broyden")
    or die "Invalid mixing=$mixing; expected linear or broyden.\n";

chomp(my $mucontrol = `getparam mucontrol param.loop 2>/dev/null`);
$mucontrol = "std" if $mucontrol eq "";
$mucontrol = lc($mucontrol);
($mucontrol eq "std" || $mucontrol eq "broyden")
    or die "Invalid mucontrol=$mucontrol; expected std or broyden.\n";

chomp(my $occupancy_mode = `getparam occupancy_mode param.loop 2>/dev/null`);
$occupancy_mode = "accurate" if $occupancy_mode eq "";
$occupancy_mode = lc($occupancy_mode);
($occupancy_mode eq "fast" || $occupancy_mode eq "accurate")
    or die "Invalid occupancy_mode=$occupancy_mode; expected fast or accurate.\n";

my $broyden_delta = ($mixing eq "broyden");
my $broyden_mu = ($mucontrol eq "broyden");
my $stdinit = 0;
if ($broyden_mu) {
    chomp(my $configured = `getparam stdinit param.loop 2>/dev/null`);
    $stdinit = $configured if $configured ne "";
    $stdinit =~ /\A\d+\z/ or die "stdinit must be a non-negative integer.\n";
    $stdinit = 0 + $stdinit;
}

chomp(my $track_value = `getparam track param.loop`);
my $track = lc($track_value) eq "true";
if ($broyden_delta || $broyden_mu) {
    $track or die "Broyden mixing/control requires track=true in param.loop.\n";
}
print "mixing=$mixing mucontrol=$mucontrol stdinit=$stdinit " .
    "occupancy_mode=$occupancy_mode\n";

wait_for_nrg($Nz);

my $source_iter = read_iteration("ITER", 0);
my $target_iter = $source_iter + 1;
build_stage($source_iter, $target_iter);
publish_ready();

sub build_stage {
    my ($source, $target) = @_;

    if (-e "res") {
        -l "res" and die "res must be a real directory, not a symlink.\n";
        remove_directory("res");
    }
    mkdir("res") or die "Can't create res/: $!";
    mkdir("dmft") if !-d "dmft";
    -d "dmft" or die "Can't create dmft/.\n";

    for my $pair (
        ["Delta.next.dat", "res/Delta.used.dat"],
        ["ReDelta.next.dat", "res/ReDelta.used.dat"],
        ["ImDelta.next.dat", "res/ImDelta.used.dat"],
        ["param.mu.next", "res/param.mu.used"],
        ["mesh.next.dat", "res/mesh.used.dat"],
    ) {
        copy_required(@$pair);
    }
    validate_delta_triplet(
        "res/Delta.used.dat", "res/ReDelta.used.dat", "res/ImDelta.used.dat", 1,
    );
    symlink("ReDelta.used.dat", "res/ReDelta.dat")
        or die "Can't create staged ReDelta alias: $!";
    symlink("ImDelta.used.dat", "res/ImDelta.dat")
        or die "Can't create staged ImDelta alias: $!";
    symlink("Delta.used.dat", "res/Delta.dat")
        or die "Can't create staged Delta alias: $!";

    msg("average");
    system("scripts/average", "res", "res/mesh.used.dat") == 0
        or die "average failed: $?";

    msg("realparts");
    system("scripts/realparts", "res") == 0 or die "realparts failed: $?";

    system("gatherlastlines", "custom") == 0 or die "gatherlastlines custom failed: $?";
    copy_required("custom", "res/custom");
    system("columnavg_comment custom >res/custom.avg") == 0
        or die "columnavg_comment custom failed: $?";
    system("gatherlastlines", "customfdm") == 0 or die "gatherlastlines customfdm failed: $?";
    copy_required("customfdm", "res/customfdm");
    system("columnavg_comment customfdm >res/customfdm.avg") == 0
        or die "columnavg_comment customfdm failed: $?";

    msg("sigmatrick");
    system("scripts/sigmatrick", "res", "res/mesh.used.dat", "res/param.mu.used", "res/customfdm.avg") == 0
        or die "sigmatrick failed: $?";

    msg("bandDOS");
    system("scripts/bandDOS", "res", "res/param.mu.used") == 0
        or die "bandDOS failed: $?";

    copy_optional("DIFFS_C", "res/DIFFS_C");
    copy_optional("DIFFS_LatLoc", "res/DIFFS_LatLoc");
    system(
        "scripts/diffs",
        "--iteration", $target,
        "--current", "res/imaw.dat",
        "--previous", "imaw.dat",
        "--local", "res/c-self.dat",
        "--mesh", "res/mesh.used.dat",
        "--output-dir", "res",
    ) == 0 or die "diffs failed: $?";

    copy_optional("occupancy.log", "res/occupancy.log");
    copy_optional("broyden.log", "res/broyden.log");
    archive_used_inputs($target) if $track;

    my $active_broyden_mu = $broyden_mu && $target > $stdinit;
    msg($active_broyden_mu ? "occupancy_measurement" : "occupancy_control");
    my $use_h0_cache = !$broyden_mu && $occupancy_mode eq "accurate";
    run_occupancy(
        target => $target,
        mu_output => "res/param.mu.next",
        history => $broyden_mu,
        measure_only => $active_broyden_mu,
        cache => $use_h0_cache,
    );

    system(
        "scripts/checkconv",
        "--iteration", $target,
        "--diffs", "res/DIFFS_C",
        "--occupancy-metrics", "res/OCCUPANCY_METRICS",
        "--decision", "res/DECISION",
    ) == 0 or die "checkconv failed: $?";

    chomp(my $decision = read_first_line("res/DECISION"));
    $decision =~ /\A(?:continue|converged|stop)\z/
        or die "Invalid convergence decision: $decision\n";

    my $next_ok = eval {
        my $raw_mu = $broyden_mu ? "res/param.mu.used" : "res/param.mu.next";
        msg("dmftDOS");
        my @dmft_dos = ("scripts/dmftDOS-stable", "--dos", "DOS.dat");
        if ($use_h0_cache) {
            push(
                @dmft_dos,
                "--h0-real", "res/H0.re.dat",
                "--h0-imaginary", "res/H0.im.dat",
                "--h0-mu", "res/H0.mu",
            );
        }
        push(@dmft_dos, "res", $raw_mu, "res/Delta.dat.NEW");
        system(@dmft_dos) == 0 or die "dmftDOS failed: $?";

        prepare_common_mesh($target, $mesh_refinement);

        if (!$broyden_delta) {
            chomp(my $alpha = `getparam alpha param.loop`);
            (0.0 < $alpha && $alpha <= 1.0) or die "alpha must satisfy 0<alpha<=1\n";
            my $old = 1.0 - $alpha;
            system("mixy $alpha res/Delta.dat.NEW-common $old res/Delta.dat.OLD-common >res/Delta.dat.TEMP") == 0
                or die "Gamma mixing failed: $?";
        }

        if ($broyden_delta || $active_broyden_mu) {
            msg("broyden");
            my @args = ("scripts/broyden.py");
            push(@args, "--delta") if $broyden_delta;
            push(@args, "--mu") if $active_broyden_mu;
            push(
                @args,
                "--workdir", "res",
                "--iteration", $target,
                "--mu-input", "res/param.mu.used",
                "--mu-output", "res/param.mu.next",
                "--history-dir", "dmft",
                "--log", "res/occupancy.log",
            );
            my $command = join(" ", @args) . " 2>&1 | tee -a res/broyden.log";
            system("bash", "-o", "pipefail", "-c", $command) == 0
                or die "broyden.py failed: $?";
        }

        system(
            "scripts/causalDelta", "res/Delta.dat.TEMP",
            "res/Delta.next.dat", "res/ReDelta.next.dat", "res/ImDelta.next.dat",
        ) == 0 or die "Causal Delta reconstruction failed: $?";
        1;
    };
    if (!$next_ok) {
        my $error = $@ || "unknown failure";
        $decision eq "continue" and die $error;
        warn "Next-cycle preparation failed after terminal decision; retaining the used inputs as restart inputs: $error";
        copy_required("res/ReDelta.used.dat", "res/ReDelta.next.dat");
        copy_required("res/ImDelta.used.dat", "res/ImDelta.next.dat");
        copy_required("res/Delta.used.dat", "res/Delta.next.dat");
        copy_required("res/param.mu.used", "res/param.mu.next");
        copy_required("res/mesh.used.dat", "res/mesh.next.dat");
        restore_staged_log("occupancy.log");
        restore_staged_log("broyden.log");
        unlink_if_exists("res/occupancy.control.log");
        unlink_if_exists("dmft/$target-Delta.raw.dat");
        unlink_if_exists("dmft/$target-mu-occup.dat");
        write_text("res/NEXT_PREPARATION_FAILED", $error);
    }

    write_text("res/ITER", "$target\n");
    validate_stage();
    $stage_validated = 1;
    my $ready = "source_iter=$source\n" .
        "target_iter=$target\n" .
        "decision=$decision\n";
    write_text("res/READY.complete", $ready);
    copy_required("res/READY.complete", "res/READY");
}

sub prepare_common_mesh {
    my ($target, $refine) = @_;
    if ($refine) {
        chomp(my $delta = `getparam opt_delta param.loop`);
        chomp(my $mindx = `getparam opt_mindx param.loop`);
        chomp(my $ymin = `getparam opt_ymin param.loop`);
        system("optimize_mesh res/Delta.dat.NEW $delta $mindx $ymin >res/Delta.dat.NEW-opt 2>res/logNEW") == 0
            or die "mesh optimization failed: $?";
        system("mesh_union res/Delta.used.dat res/Delta.dat.NEW-opt >res/mesh.next.dat 2>res/logUNION") == 0
            or die "mesh union failed: $?";
        my @resample = ("resample", "--interpolation", "steffen", "-p", "17");
        system(@resample, "res/Delta.used.dat", "res/mesh.next.dat", "res/Delta.dat.OLD-common") == 0 or die;
        system(@resample, "res/Delta.dat.NEW", "res/mesh.next.dat", "res/Delta.dat.NEW-common") == 0 or die;
    } else {
        copy_required("res/mesh.used.dat", "res/mesh.next.dat");
        copy_required("res/Delta.used.dat", "res/Delta.dat.OLD-common");
        copy_required("res/Delta.dat.NEW", "res/Delta.dat.NEW-common");
    }
}

sub run_occupancy {
    my %args = @_;
    my @command = (
        "scripts/occupancy_control",
        "--$occupancy_mode",
        "--spectrum", "res/imaw.dat",
        "--real-spectrum", "res/reaw.dat",
        "--result-dir", "res",
        "--dos", "DOS.dat",
        "--mu-input", "res/param.mu.used",
        "--mu-output", $args{mu_output},
        "--log", "res/occupancy.log",
        "--metrics", "res/OCCUPANCY_METRICS",
        "--iteration", $args{target},
        "--history-dir", "dmft",
    );
    push(@command, "--history") if $args{history};
    push(@command, "--measure-only") if $args{measure_only};
    if ($args{cache}) {
        push(
            @command,
            "--cache-real", "res/H0.re.dat",
            "--cache-imaginary", "res/H0.im.dat",
            "--cache-mu", "res/H0.mu",
        );
    }
    my $command = join(" ", @command) . " >res/occupancy.control.log 2>&1";
    system($command) == 0 or die "occupancy_control failed: $?";
}

sub archive_used_inputs {
    my ($target) = @_;
    copy_required("res/Delta.used.dat", "dmft/$target-Delta.dat");
    copy_required("res/ReDelta.used.dat", "dmft/$target-ReDelta.dat");
    copy_required("res/ImDelta.used.dat", "dmft/$target-ImDelta.dat");
    copy_required("res/param.mu.used", "dmft/$target-param.mu");
}

sub publish_ready {
    my %ready = read_ready("res/READY");
    my $source = $ready{source_iter};
    my $target = $ready{target_iter};
    my $decision = $ready{decision};
    my $current = eval { read_iteration("ITER", 0) };
    if (!defined $current) {
        warn "ITER is malformed during recovery; it will be republished from res/.\n";
        $current = $source;
    }
    $current <= $target
        or die "ITER=$current is newer than staged transaction $source->$target.\n";
    warn "ITER=$current looks truncated; republishing target iteration $target.\n"
        if $current != $source && $current != $target;

    my $stage_valid = $stage_validated || eval { validate_stage(); 1 };
    if (!$stage_valid) {
        my $error = $@ || "unknown staging validation failure";
        if ($current == $target) {
            warn "Root iteration is already published; finishing interrupted staging cleanup: $error";
            finish_publication($decision);
            return;
        }
        die $error;
    }
    msg("publish results");
    system("scripts/copyresults", "res", $target) == 0
        or die "copyresults failed: $?";

    for my $name (qw(
        DIFFS_C DIFFS_LatLoc OCCUPANCY_METRICS
        occupancy.log occupancy.control.log broyden.log
        NEXT_PREPARATION_FAILED
    )) {
        copy_optional("res/$name", $name);
    }
    unlink_if_exists("OCCUPANCY_METRICS") if !-e "res/OCCUPANCY_METRICS";
    unlink_if_exists("NEXT_PREPARATION_FAILED") if !-e "res/NEXT_PREPARATION_FAILED";
    copy_optional("res/logNEW", "logNEW.$target");
    copy_optional("res/logUNION", "logUNION.$target");

    if ($decision eq "converged") {
        local $ENV{DMFT_MU_FILE} = "param.mu.used";
        if (system("scripts/post") != 0) {
            warn "Running scripts/post failed; convergence results will still be published.\n";
            create_flag("POSTPROCESSING_FAILED");
        } else {
            unlink_if_exists("POSTPROCESSING_FAILED");
        }
    }

    for my $name (qw(
        ReDelta.next.dat ImDelta.next.dat Delta.next.dat
        param.mu.next mesh.next.dat
    )) {
        copy_required("res/$name", $name);
    }
    system("scripts/next_aliases") == 0 or die "Preparing next-input aliases failed: $?";

    unlink_if_exists("POSTPROCESSING_FAILED") if $decision ne "converged";

    copy_required("res/ITER", "ITER");
    if ($decision eq "converged") {
        create_flag("CONVERGED");
        unlink_if_exists("STOP");
    } elsif ($decision eq "stop") {
        create_flag("STOP");
        unlink_if_exists("CONVERGED");
    } else {
        unlink_if_exists("CONVERGED");
        unlink_if_exists("STOP");
    }

    verify_publication($target, $decision);
    finish_publication($decision);
}

sub finish_publication {
    my ($decision) = @_;
    msg("delete_NRG_output");
    system("delete_NRG_output") == 0 or die "delete_NRG_output failed: $?";
    remove_published_stage();

    if ($decision eq "continue") {
        system("scripts/DMFT") == 0 or die "DMFT failed: $?";
    } else {
        print colored("DONE\n", "green");
    }
}

sub validate_stage {
    my @required = qw(
        ReDelta.used.dat ImDelta.used.dat Delta.used.dat param.mu.used mesh.used.dat
        c-imG.dat c-imF.dat c-imI.dat c-reG.dat c-reF.dat c-reI.dat c-self.dat
        imsigma.dat resigma.dat imaw.dat reaw.dat
        custom custom.avg customfdm customfdm.avg
        ReDelta.next.dat ImDelta.next.dat Delta.next.dat param.mu.next mesh.next.dat
        ITER DECISION
    );
    -s "res/$_" or die "Required staged file is missing or empty: res/$_\n" for @required;
    validate_scalar("res/param.mu.used");
    validate_scalar("res/param.mu.next");
    validate_mesh_group(qw(
        res/ReDelta.used.dat res/ImDelta.used.dat res/Delta.used.dat res/mesh.used.dat
    ));
    validate_mesh_group(qw(
        res/ReDelta.next.dat res/ImDelta.next.dat res/Delta.next.dat res/mesh.next.dat
    ));
    validate_delta_triplet(
        "res/Delta.used.dat", "res/ReDelta.used.dat", "res/ImDelta.used.dat",
    );
    validate_delta_triplet(
        "res/Delta.next.dat", "res/ReDelta.next.dat", "res/ImDelta.next.dat",
    );
}

sub validate_mesh_group {
    my @files = @_;
    my $reference = read_mesh(shift @files);
    for my $file (@files) {
        my $mesh = read_mesh($file);
        @$mesh == @$reference or die "Mesh length mismatch in $file\n";
        for my $i (0 .. $#$reference) {
            my $scale = max(abs($reference->[$i]), abs($mesh->[$i]), 1.0);
            abs($reference->[$i] - $mesh->[$i]) <= 1e-11 * $scale
                or die "Frequency mesh mismatch in $file at row " . ($i + 1) . "\n";
        }
    }
}

sub read_mesh {
    my ($file) = @_;
    open(my $fh, "<", $file) or die "Can't read $file: $!";
    my @mesh;
    while (<$fh>) {
        next if /^\s*$/;
        my ($x, $y) = split;
        defined($x) && defined($y) or die "Expected two columns in $file\n";
        is_number($x) && is_number($y) or die "Non-numeric value in $file\n";
        @mesh && $x <= $mesh[-1] and die "Mesh is not strictly increasing in $file\n";
        push(@mesh, 0 + $x);
    }
    close($fh);
    @mesh >= 2 or die "Too few rows in $file\n";
    return \@mesh;
}

sub validate_delta_triplet {
    my ($gamma_file, $real_file, $imaginary_file, $skip_real_check) = @_;
    my ($gamma_mesh, $gamma) = read_table($gamma_file);
    my ($real_mesh, $real) = read_table($real_file);
    my ($imaginary_mesh, $imaginary) = read_table($imaginary_file);
    require_meshes_equal($gamma_mesh, $real_mesh, $real_file);
    require_meshes_equal($gamma_mesh, $imaginary_mesh, $imaginary_file);
    $gamma->[0] == 0.0 && $gamma->[-1] == 0.0
        or die "$gamma_file must have exact-zero outer support points\n";
    my $clip = delta_clip();
    for my $index (0 .. $#$gamma) {
        $gamma->[$index] >= 0.0
            or die "Negative Gamma in $gamma_file at row " . ($index + 1) . "\n";
        if ($index > 0 && $index < $#$gamma) {
            $gamma->[$index] >= $clip * (1.0 - 1e-12)
                or die "Gamma is below clipDelta in $gamma_file at row " . ($index + 1) . "\n";
        }
        my $scale = max(abs($gamma->[$index]), abs($imaginary->[$index]), 1.0);
        abs($gamma->[$index] + $imaginary->[$index]) <= 1e-12 * $scale
            or die "$imaginary_file is inconsistent with $gamma_file at row " . ($index + 1) . "\n";
    }
    return if $skip_real_check;

    my $kk_file = "$real_file.validate-kk.$$";
    unlink_if_exists($kk_file);
    my $valid = eval {
        system("kk", "-v", "--interpolation", "steffen", "--algorithm", "analytic", $imaginary_file, $kk_file) == 0
            or die "KK validation failed for $imaginary_file: $?\n";
        my ($kk_mesh, $dynamic_real) = read_table($kk_file);
        require_meshes_equal($gamma_mesh, $kk_mesh, $kk_file);
        my $eps = delta_eps();
        for my $index (0 .. $#$real) {
            my $expected = $dynamic_real->[$index] + $eps;
            isfinite($expected) or die "Non-finite reconstructed ReDelta in $real_file\n";
            my $scale = max(abs($real->[$index]), abs($expected), 1.0);
            my $error = $real->[$index] - $expected;
            abs($error) <= 5e-12 * $scale
                or die "$real_file is not KK[$imaginary_file]+param.eps at row " .
                    ($index + 1) . " error=$error scale=$scale\n";
        }
        1;
    };
    my $error = $@;
    unlink_if_exists($kk_file);
    $valid or die $error;
}

sub read_table {
    my ($file) = @_;
    open(my $fh, "<", $file) or die "Can't read $file: $!";
    my (@mesh, @values);
    while (<$fh>) {
        next if /^\s*$/;
        my @fields = split;
        @fields == 2 or die "Expected two columns in $file\n";
        is_number($fields[0]) && is_number($fields[1])
            or die "Non-numeric value in $file\n";
        my ($omega, $value) = map { finite_number($_, $file) } @fields;
        @mesh && $omega <= $mesh[-1]
            and die "Mesh is not strictly increasing in $file\n";
        push(@mesh, $omega);
        push(@values, $value);
    }
    close($fh);
    @mesh >= 2 or die "Too few rows in $file\n";
    return (\@mesh, \@values);
}

sub require_meshes_equal {
    my ($reference, $candidate, $file) = @_;
    @$candidate == @$reference or die "Mesh length mismatch in $file\n";
    for my $index (0 .. $#$reference) {
        my $scale = max(abs($reference->[$index]), abs($candidate->[$index]), 1.0);
        abs($reference->[$index] - $candidate->[$index]) <= 1e-11 * $scale
            or die "Frequency mesh mismatch in $file at row " . ($index + 1) . "\n";
    }
}

sub validate_scalar {
    my ($file) = @_;
    read_finite_scalar($file);
}

sub is_number {
    my ($value) = @_;
    return defined($value) && $value =~ /\A[+-]?(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][+-]?\d+)?\z/;
}

sub finite_number {
    my ($value, $context) = @_;
    is_number($value) or die "Invalid numeric value in $context\n";
    my $number = 0.0 + $value;
    isfinite($number) or die "Non-finite numeric value in $context\n";
    return $number;
}

sub read_finite_scalar {
    my ($file) = @_;
    open(my $fh, "<", $file) or die "Can't read $file: $!";
    local $/;
    my $text = <$fh>;
    close($fh) or die "Can't close $file: $!";
    defined($text) or die "$file is empty\n";
    $text =~ s/^\s+|\s+$//g;
    return finite_number($text, $file);
}

sub optional_parameter {
    my ($name) = @_;
    open(my $fh, "-|", "getparam", $name, "param.loop")
        or die "Can't run getparam: $!";
    local $/;
    my $text = <$fh>;
    my $ok = close($fh);
    return if !$ok || !defined($text) || $text !~ /\S/;
    $text =~ s/^\s+|\s+$//g;
    return finite_number($text, "$name in param.loop");
}

sub delta_clip {
    return $cached_delta_clip if defined($cached_delta_clip);
    $cached_delta_clip = optional_parameter("clipDelta");
    $cached_delta_clip = optional_parameter("clip")
        if !defined($cached_delta_clip);
    defined($cached_delta_clip) && $cached_delta_clip > 0.0
        or die "clipDelta must be a finite positive number in param.loop\n";
    return $cached_delta_clip;
}

sub delta_eps {
    return $cached_delta_eps if defined($cached_delta_eps);
    $cached_delta_eps = read_finite_scalar("param.eps");
    return $cached_delta_eps;
}

sub verify_publication {
    my ($target, $decision) = @_;
    my %mapping = (
        "c-self.dat" => "self.dat",
    );
    for my $name (qw(
        c-imG.dat c-imF.dat c-imI.dat c-reG.dat c-reF.dat c-reI.dat
        imsigma.dat resigma.dat imaw.dat reaw.dat
        ReDelta.used.dat ImDelta.used.dat Delta.used.dat param.mu.used mesh.used.dat
        ReDelta.next.dat ImDelta.next.dat Delta.next.dat param.mu.next mesh.next.dat
    )) {
        $mapping{$name} = $name;
    }
    for my $source (sort keys %mapping) {
        my $destination = $mapping{$source};
        compare("res/$source", $destination) == 0
            or die "Published $destination differs from res/$source\n";
    }
    for my $name (qw(custom custom.avg customfdm customfdm.avg)) {
        next if !-s "res/$name";
        compare("res/$name", $name) == 0
            or die "Published $name differs from res/$name\n";
    }
    if (-e "res/OCCUPANCY_METRICS") {
        compare("res/OCCUPANCY_METRICS", "OCCUPANCY_METRICS") == 0
            or die "Published occupancy metrics differ from res/OCCUPANCY_METRICS\n";
    }
    chomp(my $published_track = `getparam track param.loop`);
    if (lc($published_track) eq "true") {
        compare("res/Delta.used.dat", "dmft/$target-Delta.dat") == 0 or die "Broyden Delta history mismatch\n";
        compare("res/ReDelta.used.dat", "dmft/$target-ReDelta.dat") == 0 or die "Broyden ReDelta history mismatch\n";
        compare("res/ImDelta.used.dat", "dmft/$target-ImDelta.dat") == 0 or die "Broyden ImDelta history mismatch\n";
        compare("res/param.mu.used", "dmft/$target-param.mu") == 0 or die "Broyden mu history mismatch\n";
    }
    read_iteration("ITER", -1) == $target or die "Failed to publish ITER=$target\n";
    $decision eq "converged" && !-e "CONVERGED" and die "CONVERGED flag was not published\n";
    $decision eq "stop" && !-e "STOP" and die "STOP flag was not published\n";
    $decision eq "converged" && -e "STOP" and die "Stale STOP flag remains\n";
    $decision eq "stop" && -e "CONVERGED" and die "Stale CONVERGED flag remains\n";
    $decision eq "continue" && (-e "STOP" || -e "CONVERGED")
        and die "Terminal flag remains for a continuing iteration\n";
    verify_alias("ReDelta.dat", "ReDelta.next.dat");
    verify_alias("ImDelta.dat", "ImDelta.next.dat");
    verify_alias("Delta.dat", "Delta.next.dat");
    verify_alias("param.mu", "param.mu.next");
    verify_alias("mesh.dat", "mesh.next.dat");
}

sub verify_alias {
    my ($alias, $target) = @_;
    -l $alias or die "$alias is not a symlink\n";
    my $actual = readlink($alias);
    defined($actual) && $actual eq $target
        or die "$alias does not point to $target\n";
}

sub read_ready {
    my ($file) = @_;
    open(my $fh, "<", $file) or die "Can't read $file: $!";
    my %values;
    while (<$fh>) {
        chomp;
        my ($key, $value) = split(/=/, $_, 2);
        defined($key) && defined($value) or die "Malformed $file\n";
        $values{$key} = $value;
    }
    close($fh);
    for my $key (qw(source_iter target_iter decision)) {
        exists($values{$key}) or die "Missing $key in $file\n";
    }
    $values{source_iter} =~ /\A\d+\z/ or die "Invalid source iteration in $file\n";
    $values{target_iter} =~ /\A\d+\z/ or die "Invalid target iteration in $file\n";
    $values{target_iter} == $values{source_iter} + 1 or die "Invalid iteration transition in $file\n";
    $values{decision} =~ /\A(?:continue|converged|stop)\z/ or die "Invalid decision in $file\n";
    return %values;
}

sub recover_ready_marker {
    if (-s "res/READY") {
        return 1 if eval { my %ready = read_ready("res/READY"); 1 };
        warn "Ignoring malformed res/READY.\n";
    }
    if (-s "res/READY.complete"
        && eval { my %ready = read_ready("res/READY.complete"); 1 }) {
        copy_required("res/READY.complete", "res/READY");
        return 1;
    }
    return 0;
}

sub read_iteration {
    my ($file, $default) = @_;
    return $default if !-e $file;
    my $value = read_first_line($file);
    $value =~ s/^\s+|\s+$//g;
    $value =~ /\A\d+\z/ or die "Invalid iteration in $file: $value\n";
    return 0 + $value;
}

sub read_first_line {
    my ($file) = @_;
    open(my $fh, "<", $file) or die "Can't read $file: $!";
    my $line = <$fh>;
    close($fh);
    defined($line) or die "$file is empty\n";
    chomp($line);
    return $line;
}

sub write_text {
    my ($file, $text) = @_;
    open(my $fh, ">", $file) or die "Can't write $file: $!";
    print $fh $text or die "Can't write $file: $!";
    close($fh) or die "Can't close $file: $!";
}

sub create_flag {
    my ($file) = @_;
    write_text($file, "\n");
}

sub unlink_if_exists {
    my ($file) = @_;
    return if !-e $file && !-l $file;
    unlink($file) or die "Can't remove $file: $!";
}

sub copy_required {
    my ($source, $destination) = @_;
    -s $source or die "Required source is missing or empty: $source\n";
    copy($source, $destination) or die "Can't copy $source to $destination: $!";
    -s $destination or die "Copy produced an empty file: $destination\n";
}

sub copy_optional {
    my ($source, $destination) = @_;
    return if !-e $source;
    copy($source, $destination) or die "Can't copy $source to $destination: $!";
}

sub restore_staged_log {
    my ($name) = @_;
    if (-e $name) {
        copy_optional($name, "res/$name");
    } else {
        unlink_if_exists("res/$name");
    }
}

sub remove_directory {
    my ($directory) = @_;
    my $errors;
    remove_tree($directory, {error => \$errors});
    $errors //= [];
    if (@$errors) {
        my @messages;
        for my $entry (@$errors) {
            my ($file, $message) = %$entry;
            push(@messages, "$file: $message");
        }
        die "Failed to remove $directory: " . join(", ", @messages) . "\n";
    }
}

sub remove_published_stage {
    my $marker = -e "res/READY.complete" ? "READY.complete" : "READY";
    opendir(my $dh, "res") or die "Can't open res/: $!";
    my @entries = grep { $_ ne "." && $_ ne ".." && $_ ne $marker } readdir($dh);
    closedir($dh);
    for my $entry (@entries) {
        my $path = "res/$entry";
        if (-d $path && !-l $path) {
            remove_directory($path);
        } else {
            unlink($path) or die "Can't remove $path: $!";
        }
    }
    unlink("res/$marker") or die "Can't remove res/$marker: $!";
    rmdir("res") or die "Can't remove empty res/: $!";
}

sub wait_for_nrg {
    my ($count) = @_;
    while (1) {
        my $done = 1;
        for my $i (1 .. $count) {
            system("ls", $i); # Refresh filesystem caches used by some NFS setups.
            if (!-e "$i/DONE") {
                print "Not done: $i\n";
                $done = 0;
            }
        }
        print "Nz=$count done=$done\n";
        return if $done;
        sleep 60;
    }
}

sub msg {
    my ($message) = @_;
    print RED, "$message\n", RESET;
}
