#!/usr/bin/env perl
# Calculate optical conductivity
# Warning: This scripts read Phi(epsilon) from a file
# Rok Zitko, rok.zitko@ijs.si, 2017-2026

use strict;
use warnings;
use FindBin;
use lib $FindBin::Bin;
use Bubble qw(bubble_options bubble_scalar chemical_potential parameter);
use Math::Complex;

my $verbose = 1;

my $T = parameter("T");
$T > 0.0 or die "T must be positive\n";

my $factor = pi**2;
# pi^2 from the difference between A(w)=-1/Pi Im[..] and a(w)=-Im[..]

my $mu = chemical_potential();

my $fn = "PHI.dat"; # transport function
my @param = (bubble_options(epsabs => "2e-7", epsrel => "1e-8"), "-p", $fn);

sub calc {
    my $Omega = shift;
    my $res = bubble_scalar("-O", $Omega, @param, 0, 2, 0, $T, $mu,
                            "resigma.dat", "imsigma.dat");
    my $a0 = $factor*$res;
    my $cond = $a0;
    return $cond;
}

my $output_name = "cond.opt-PHI.dat";
my $temporary = "$output_name.tmp.$$";
END { unlink($temporary) if defined($temporary) && -e $temporary; }
unlink($temporary);
open(my $output, ">", $temporary) or die "Can't write $temporary: $!";

for (my $Omega = 1e-7; $Omega < 5.0; $Omega *= 1.1) {
    my $cond = calc($Omega);
    if ($verbose) {
        print "$Omega $cond\n";
    }
    print {$output} sprintf("%.17g %.17g\n", $Omega, $cond)
        or die "Can't write $temporary: $!";
}

close($output) or die "Can't close $temporary: $!";
rename($temporary, $output_name) or die "Can't replace $output_name: $!";
