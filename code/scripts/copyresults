#!/usr/bin/env perl
# Copy the (processed) results of the current NRG iteration.
# Rok Zitko, rok.zitko@ijs.si, 2008-2026

use strict;
use warnings;
use File::Copy qw(copy);

my $stage = @ARGV ? shift @ARGV : "res";
my $iter = @ARGV ? shift @ARGV : `getiter`;
@ARGV and die "Usage: $0 [stage_dir [iteration]]\n";
chomp($iter);
$iter =~ /\A\d+\z/ && $iter >= 1 or die "Invalid iteration: $iter\n";
-d $stage or die "Result staging directory not found: $stage\n";

# Broyden mixing requires the per-iteration Gamma snapshots, so $track must be 1.
my $track = 1; # 0=do not store copies in dmft/, 1=track DMFT iteration by storing copies of all results in dmft/.

chomp(my $tr = `getparam track param.loop`);
$track = (lc($tr) eq "true")  ? 1 : 0;

sub archive {
    my ($source, $name) = @_;
    if ($track) {
        copy("$stage/$source", "dmft/$iter-$name")
            or die "Archiving $source failed: $!, stopped";
    }
}

sub archive_optional {
    my ($source, $name) = @_;
    if ($track && -e $source) {
        copy($source, "dmft/$iter-$name")
            or warn "Warning: Archiving $source failed: $!";
    }
}

sub publish {
    my ($source, $destination) = @_;
    copy("$stage/$source", $destination)
        or die "Publishing $source as $destination failed: $!, stopped";
    -s $destination or die "Published file is empty: $destination\n";
}

system("mkdir -p dmft") == 0 or die; # Ensure dmft/ exists.

archive("c-imG.dat", "c-imG.dat");
archive("c-self.dat", "c-self.dat");
archive($_, $_) for qw(imsigma.dat resigma.dat imaw.dat reaw.dat);
archive("Delta.used.dat", "Delta.dat");
# Derived components are retained for diagnostics, not as Broyden state.
archive("ReDelta.used.dat", "ReDelta.dat");
archive("ImDelta.used.dat", "ImDelta.dat");
archive("param.mu.used", "param.mu");

publish($_, $_) for qw(
    c-imG.dat c-imF.dat c-imI.dat
    c-reG.dat c-reF.dat c-reI.dat
    imsigma.dat resigma.dat imaw.dat reaw.dat
);
publish("c-self.dat", "self.dat");
publish($_, $_) for qw(
    ReDelta.used.dat ImDelta.used.dat Delta.used.dat
    param.mu.used mesh.used.dat
);

# NRG iteration logs, etc.
archive_optional("1/custom", "custom");
archive_optional("1/log", "log");
archive_optional("1/td", "td");

# Expectation values
for my $fn (qw(custom custom.avg customfdm customfdm.avg)) {
    if (-s "$stage/$fn") {
        publish($fn, $fn);
        archive($fn, $fn);
    }
}
