#!/usr/bin/env perl
# Calculate lattice Green's function
# Input: chemical potential mu, self-energy Sigma (resigma.dat, imsigma.dat)
# Output: Green's function multiplied by -1/pi (imaw.dat, reaw.dat)
# Rok Zitko, rok.zitko@ijs.si, 2024-2026

use strict;
use warnings;
use File::Basename qw(dirname);
use File::Path qw(make_path);
use File::Spec;
use Getopt::Long qw(GetOptions);
use POSIX qw(isfinite);

my $number = qr/[+-]?(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][+-]?\d+)?/;

my ($mu_value, $re_requested, $im_requested);
my $dos_file = "DOS.dat";
GetOptions(
  "mu-value=s" => \$mu_value,
  "re-output=s" => \$re_requested,
  "im-output=s" => \$im_requested,
  "dos=s" => \$dos_file,
) or die usage();

my $result_dir = @ARGV ? shift @ARGV : "res";
my $mu_file = @ARGV ? shift @ARGV : undef;
@ARGV and die usage();
defined($mu_value) && defined($mu_file)
  and die "--mu-value and a chemical-potential file are mutually exclusive.\n";
defined($re_requested) == defined($im_requested)
  or die "--re-output and --im-output must be provided together.\n";
$mu_file //= "param.mu";

make_path($result_dir) unless -d $result_dir;
-d $result_dir or die "Failed to create $result_dir.";

my $mu;
if (defined($mu_value)) {
  $mu = parse_scalar($mu_value, "--mu-value");
} else {
  open(my $mu_fh, "<", $mu_file) or die "Can't open $mu_file for reading, stopped";
  {
    local $/;
    $mu = <$mu_fh>;
  }
  close($mu_fh);
  defined $mu or die "Chemical potential not found in $mu_file";
  chomp($mu);
  $mu = parse_scalar($mu, $mu_file);
}

# Use the same causal self-energy floor as the self-energy reconstruction.
chomp(my $sigma_clip = `getparam clipSigma param.loop`);
if ($sigma_clip eq "") {
  chomp($sigma_clip = `getparam clip param.loop`); # fall back
}
$sigma_clip = parse_scalar($sigma_clip, "clipSigma");
$sigma_clip > 0.0 or die;

print("bandDOS mu=$mu sigma_clip=$sigma_clip\n");

my $re_output = output_target($re_requested // "$result_dir/reaw.dat");
my $im_output = output_target($im_requested // "$result_dir/imaw.dat");
path_key($re_output) ne path_key($im_output)
  or die "Real and imaginary outputs must be distinct files.\n";
-d dirname($re_output) or die "Output directory does not exist for $re_output.\n";
-d dirname($im_output) or die "Output directory does not exist for $im_output.\n";
-f $dos_file or die "DOS table not found: $dos_file\n";
my %protected = map { path_key($_) => $_ } (
  "$result_dir/resigma.dat", "$result_dir/imsigma.dat", $dos_file, $mu_file,
);
for my $output ($re_output, $im_output) {
  my $key = path_key($output);
  exists($protected{$key})
    and die "Output $output collides with input $protected{$key}.\n";
}
my $re_temporary = "$re_output.tmp.$$";
my $im_temporary = "$im_output.tmp.$$";
END {
    unlink($re_temporary) if defined($re_temporary) && -e $re_temporary;
    unlink($im_temporary) if defined($im_temporary) && -e $im_temporary;
}
system("hilb", "-v", "-i", "steffen", "--gsl-error-policy", "warn",
       "--algorithm", "analytic",
       "-d", $dos_file, "-x", $mu,
       "-c", $sigma_clip, "-f", "1e-12",
       "$result_dir/resigma.dat", "$result_dir/imsigma.dat",
       $re_temporary, $im_temporary) == 0
    or die "hilb failed: $?";

my $re_mesh = validate_table($re_temporary, 0);
my $im_mesh = validate_table($im_temporary, 1);
my $sigma_re_mesh = validate_table("$result_dir/resigma.dat", 0);
my $sigma_im_mesh = validate_table("$result_dir/imsigma.dat", 0);
require_same_mesh($sigma_re_mesh, $sigma_im_mesh, "self-energy inputs");
require_same_mesh($sigma_re_mesh, $re_mesh, "real Hilbert output");
require_same_mesh($sigma_re_mesh, $im_mesh, "imaginary Hilbert output");
rename($re_temporary, $re_output) or die "Can't replace $re_output: $!";
rename($im_temporary, $im_output) or die "Can't replace $im_output: $!";

sub usage {
  return "Usage: $0 [--mu-value VALUE] [--re-output FILE --im-output FILE] " .
    "[--dos FILE] [result_dir [mu_file]]\n";
}

sub output_target {
  my ($path) = @_;
  return $path unless -l $path;
  my $target = readlink($path);
  defined($target) or die "Can't read output symlink $path: $!";
  return $target if File::Spec->file_name_is_absolute($target);
  return File::Spec->catfile(dirname($path), $target);
}

sub path_key {
  my ($path) = @_;
  return File::Spec->canonpath(File::Spec->rel2abs($path));
}

sub validate_table {
    my ($filename, $require_nonnegative) = @_;
    open(my $fh, "<", $filename) or die "Can't read $filename: $!";
    my $previous;
    my @mesh;
    while (<$fh>) {
        next if /^\s*$/;
        my @fields = split;
        @fields == 2 or die "Expected two columns in $filename at line $.\n";
        $fields[0] =~ /\A$number\z/ && $fields[1] =~ /\A$number\z/
            or die "Invalid numeric value in $filename at line $.\n";
        my ($omega, $value) = map { 0.0 + $_ } @fields;
        isfinite($omega) && isfinite($value)
            or die "Non-finite value in $filename at line $.\n";
        defined($previous) && $omega <= $previous
            and die "Non-increasing mesh in $filename at line $.\n";
        !$require_nonnegative || $value >= 0.0
            or die "Negative spectral value in $filename at line $.: $value\n";
        $previous = $omega;
        push(@mesh, $omega);
    }
    close($fh) or die "Can't close $filename: $!";
    @mesh >= 2 or die "Too few rows in $filename\n";
    return \@mesh;
}

sub parse_scalar {
    my ($text, $context) = @_;
    defined($text) && $text =~ /\A\s*($number)\s*\z/
        or die "Invalid $context value\n";
    my $value = 0.0 + $1;
    isfinite($value) or die "Non-finite $context value\n";
    return $value;
}

sub require_same_mesh {
    my ($reference, $candidate, $context) = @_;
    @$reference == @$candidate or die "$context mesh-size mismatch\n";
    for (my $index = 0; $index < @$reference; ++$index) {
        my $scale = abs($reference->[$index]);
        $scale = abs($candidate->[$index]) if abs($candidate->[$index]) > $scale;
        $scale = 1.0 if $scale < 1.0;
        abs($reference->[$index] - $candidate->[$index]) <= 1e-12 * $scale
            or die "$context frequency mismatch at row " . ($index + 1) . "\n";
    }
}
