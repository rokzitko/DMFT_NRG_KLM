#!/usr/bin/env perl
# Calculate lattice Green's function
# Input: chemical potential mu, self-energy Sigma (resigma.dat, imsigma.dat)
# Output: Green's function multiplied by -1/pi (imaw.dat, reaw.dat)
# Rok Zitko, rok.zitko@ijs.si, 2024-2026

use strict;
use warnings;
use File::Path qw(make_path);

my $number = qr/[+-]?(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][+-]?\d+)?/;

my $result_dir = @ARGV ? shift @ARGV : "res";
my $mu_file = @ARGV ? shift @ARGV : "param.mu";
@ARGV and die "Usage: $0 [result_dir [mu_file]]\n";

make_path($result_dir) unless -d $result_dir;
-d $result_dir or die "Failed to create $result_dir.";

open(my $mu_fh, "<", $mu_file) or die "Can't open $mu_file for reading, stopped";
my $mu = <$mu_fh>;
close($mu_fh);
defined $mu or die "Chemical potential not found in $mu_file";
chomp($mu);

# Use the same causal self-energy floor as the self-energy reconstruction.
chomp(my $sigma_clip = `getparam clipSigma param.loop`);
if ($sigma_clip eq "") {
  chomp($sigma_clip = `getparam clip param.loop`); # fall back
}
$sigma_clip ne "" or die;
$sigma_clip > 0.0 or die;

print("bandDOS mu=$mu sigma_clip=$sigma_clip\n");

my $re_output = "$result_dir/reaw.dat";
my $im_output = "$result_dir/imaw.dat";
my $re_temporary = "$re_output.tmp.$$";
my $im_temporary = "$im_output.tmp.$$";
END {
    unlink($re_temporary) if defined($re_temporary) && -e $re_temporary;
    unlink($im_temporary) if defined($im_temporary) && -e $im_temporary;
}
system("hilb", "-v", "-i", "steffen", "-d", "DOS.dat", "-x", $mu,
       "-c", $sigma_clip, "-f", "1e-12",
       "$result_dir/resigma.dat", "$result_dir/imsigma.dat",
       $re_temporary, $im_temporary) == 0
    or die "hilb failed: $?";

my $re_mesh = validate_table($re_temporary, 0);
my $im_mesh = validate_table($im_temporary, 1);
@$re_mesh == @$im_mesh or die "Hilbert-output mesh-size mismatch\n";
for (my $index = 0; $index < @$re_mesh; ++$index) {
    $re_mesh->[$index] == $im_mesh->[$index]
        or die "Hilbert-output frequency mismatch at row " . ($index + 1) . "\n";
}
rename($re_temporary, $re_output) or die "Can't replace $re_output: $!";
rename($im_temporary, $im_output) or die "Can't replace $im_output: $!";

sub validate_table {
    my ($filename, $require_nonnegative) = @_;
    open(my $fh, "<", $filename) or die "Can't read $filename: $!";
    my $previous;
    my @mesh;
    while (<$fh>) {
        next if /^\s*$/;
        my @fields = split;
        @fields == 2 or die "Expected two columns in $filename at line $.\n";
        $fields[0] =~ /\A$number\z/ && $fields[1] =~ /\A$number\z/
            or die "Invalid numeric value in $filename at line $.\n";
        my ($omega, $value) = map { 0.0 + $_ } @fields;
        abs($omega) <= 1.7976931348623157e308
            && abs($value) <= 1.7976931348623157e308
            or die "Non-finite value in $filename at line $.\n";
        defined($previous) && $omega <= $previous
            and die "Non-increasing mesh in $filename at line $.\n";
        !$require_nonnegative || $value >= 0.0
            or die "Negative spectral value in $filename at line $.: $value\n";
        $previous = $omega;
        push(@mesh, $omega);
    }
    close($fh) or die "Can't close $filename: $!";
    @mesh >= 2 or die "Too few rows in $filename\n";
    return \@mesh;
}
