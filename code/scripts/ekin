#!/usr/bin/env perl
# Computes kinetic energy
# Rok Zitko, nov 2017
use strict;
use warnings;
use FindBin;
use lib $FindBin::Bin;
use Bubble qw(bubble_options bubble_scalar chemical_potential parameter write_scalar);

my $T = parameter("T");
$T > 0.0 or die "T must be positive\n";
my $mu = chemical_potential();

my @param = bubble_options(epsabs => "1e-7", epsrel => "1e-8");

my $res = bubble_scalar(@param, "-e", "1", "-p", "DOS.dat", "-f",
                        0, 1, 0, $T, $mu, "resigma.dat", "imsigma.dat");
$res *= 2; # spin!

write_scalar("ekin.dat", $res);
