#!/usr/bin/env perl
# dmft_init - prepare a new DMFT run
# Rok Zitko, 2008-2026

use strict;
use warnings;
use File::Copy qw(copy);
use File::Path qw(remove_tree);
use FindBin;
use POSIX qw(isfinite);

-s "param.mu" or -s "param.mu.next"
    or die "Chemical potential param.mu not found.";
-s "param.eps" or die "Static hybridization shift param.eps not found.";
-s "param.loop" or die "Parameter file param.loop not found.";
mkdir("dmft") if !-d "dmft";
-d "dmft" or die "Can't create subdir dmft.";

if (-s "res.init/READY") {
    for my $name (qw(Delta.next.dat ReDelta.next.dat ImDelta.next.dat)) {
        next if !-s "res.init/$name";
        copy("res.init/$name", $name) or die "Can't recover initial $name: $!";
    }
}

system("$FindBin::Bin/next_aliases") == 0
    or die "Preparing next-input aliases failed: $?";
-s "param.mu.next" or die "Chemical potential param.mu.next not found.";

my $recovered_resample = 0;
if (-s "mesh.next.dat.resample-ready") {
    system(
        "$FindBin::Bin/resampleDelta", "Delta.next.dat", "mesh.next.dat",
        "ReDelta.next.dat", "ImDelta.next.dat",
    ) == 0 or die "Recovering interrupted Delta remeshing failed: $?";
    $recovered_resample = 1;
}

# Explicit legacy ingress: derive Gamma once from ImDelta, then discard both
# independently supplied components during causal reconstruction below.
if (!-s "Delta.next.dat" && -s "ImDelta.next.dat") {
    derive_gamma("ImDelta.next.dat", "Delta.next.dat");
}

if (-s "Delta.next.dat") {
    if (!$recovered_resample) {
        system(
            "$FindBin::Bin/causalDelta", "Delta.next.dat", "Delta.next.dat",
            "ReDelta.next.dat", "ImDelta.next.dat",
        ) == 0 or die "Restart Delta canonicalization failed: $?";
        system(
            "$FindBin::Bin/resampleDelta", "Delta.next.dat", "mesh.next.dat",
            "ReDelta.next.dat", "ImDelta.next.dat",
        ) == 0 or die "Delta remeshing failed: $?";
    }
} elsif (-e "Delta.next.dat" || -e "ImDelta.next.dat" || -e "ReDelta.next.dat") {
    die "Restart hybridization files are incomplete or empty.\n";
} else {
    my $initdir = "res.init";
    remove_directory($initdir) if -e $initdir;
    mkdir($initdir) or die "Can't create temporary subdir $initdir: $!";
    if (!-s "mesh.next.dat") {
        system("$FindBin::Bin/init_mesh >mesh.next.dat") == 0
            or die "init_mesh failed: $?";
    }
    system("$FindBin::Bin/init_Sigma", $initdir, "mesh.next.dat") == 0
        or die "init_Sigma failed: $?";
    system("$FindBin::Bin/bandDOS", $initdir, "param.mu.next") == 0
        or die "bandDOS failed: $?";
    system(
        "$FindBin::Bin/dmftDOS-stable", $initdir, "param.mu.next",
        "$initdir/Delta.raw.dat",
    ) == 0 or die "Initial DMFT update failed: $?";
    system(
        "$FindBin::Bin/causalDelta", "$initdir/Delta.raw.dat",
        "$initdir/Delta.next.dat", "$initdir/ReDelta.next.dat",
        "$initdir/ImDelta.next.dat",
    ) == 0 or die "Initial causal Delta reconstruction failed: $?";
    write_text("$initdir/READY", "ready\n");
    for my $name (qw(ReDelta.next.dat ImDelta.next.dat Delta.next.dat)) {
        copy("$initdir/$name", $name) or die "Can't publish initial $name: $!";
    }
    remove_directory($initdir);
}

-s "Delta.next.dat" or die "Authoritative Delta.next.dat not found.";
-s "ReDelta.next.dat" or die "Derived ReDelta.next.dat not found.";
-s "ImDelta.next.dat" or die "Derived ImDelta.next.dat not found.";
-s "mesh.next.dat" or die "Next-cycle mesh not found.";
remove_directory("res.init") if -d "res.init";
system("$FindBin::Bin/next_aliases") == 0
    or die "Preparing next-input aliases failed: $?";

sub derive_gamma {
    my ($input, $output) = @_;
    open(my $in, "<", $input) or die "Can't read $input: $!";
    my $temporary = "$output.tmp.$$";
    open(my $out, ">", $temporary) or die "Can't write $temporary: $!";
    my $previous;
    while (<$in>) {
        next if /^\s*(?:#.*)?$/;
        my @fields = split;
        @fields == 2 or die "Expected two columns in $input at line $.\n";
        my ($omega, $imaginary) = map { parse_number($_, "$input at line $.") } @fields;
        defined($previous) && $omega <= $previous
            and die "Frequency mesh is not strictly increasing in $input at line $.\n";
        printf {$out} "%.17g %.17g\n", $omega, -$imaginary;
        $previous = $omega;
    }
    close($in) or die "Can't close $input: $!";
    close($out) or die "Can't close $temporary: $!";
    -s $temporary or die "No hybridization rows found in $input\n";
    rename($temporary, $output) or die "Can't replace $output: $!";
}

sub parse_number {
    my ($text, $context) = @_;
    $text =~ /\A[+-]?(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][+-]?\d+)?\z/
        or die "Invalid numeric value in $context\n";
    my $value = 0.0 + $text;
    isfinite($value) or die "Non-finite numeric value in $context\n";
    return $value;
}

sub write_text {
    my ($file, $text) = @_;
    open(my $fh, ">", $file) or die "Can't write $file: $!";
    print {$fh} $text or die "Can't write $file: $!";
    close($fh) or die "Can't close $file: $!";
}

sub remove_directory {
    my ($directory) = @_;
    my $errors;
    remove_tree($directory, {error => \$errors});
    $errors //= [];
    @$errors and die "Failed to remove $directory/.\n";
}
