#!/usr/bin/env perl
# Start the DMFT calculation by running this script!
# Rok Zitko, rok.zitko@ijs.si, 2022-2026

use strict;
use warnings;
use IPC::Cmd qw(can_run);

my $mma = 0; # 0=instantiate (stand-alone), 1=nrginit (Mathematica)
my $local = 1; #0=submit a Slurm job, 1=run locally

system("scripts/validate_bare_inputs") == 0
    or die "Bare-input validation failed: $?";

if (-e "res/READY" || -e "res/READY.complete") {
    system("scripts/dmft_done") == 0
        or die "Recovering staged DMFT results failed: $?";
    exit 0;
}
if (-d "res" && (-s "res/MIGRATED"
    || (-s "res/c-imG.dat"
    && (-s "res/Delta.dat" || -s "res/ImDelta.dat")
    && !-e "res/Delta.used.dat"))) {
    system("scripts/migrate_legacy_res") == 0
        or die "Migrating legacy res/ results failed: $?";
}
if (-d "res") {
    opendir(my $res_dh, "res") or die "Can't inspect res/: $!";
    my @entries = grep { $_ ne "." && $_ ne ".." } readdir($res_dh);
    closedir($res_dh);
    rmdir("res") if !@entries;
}
-e "res" and die "Incomplete res/ staging directory exists; run scripts/dmft_done to rebuild it.\n";
-e "CONVERGED" and die "Calculation is already marked CONVERGED.\n";
-e "STOP" and die "Calculation is already marked STOP.\n";

system("scripts/dmft_init") == 0 or die "dmft_init failed: $?";

-s "Delta.next.dat" or die("Hybridisation function not found, stopped");
system("scripts/next_aliases") == 0 or die "Preparing next-input aliases failed: $?";
system("scripts/checkDelta") == 0 or die;

chomp(my $Nz = `getparam Nz param.loop`);
$Nz >= 1 or die;

# Chemical potential
open(my $mu_fh, "<", "param.mu.next") or die "Can't open param.mu.next: $!";
chomp(my $mu = <$mu_fh>);
close($mu_fh);

# Additional energy-level shift
chomp(my $shift = `cat param.eps`);

my $epsimp = $shift-$mu; # impurity level for NRG calculation
print "mu=$mu shift=$shift $epsimp=$epsimp\n";

# Perform the discretization
system("m4 -DEPS=$epsimp -DZZZ=1 param.loop >param") == 0 or die "m4 failed: $?";
unlink "FSOL.dat"; # Delete first, avoid check passing with stale data.
unlink "FSOLNEG.dat";
my $adapt_cfg = "--integral";
system("adapt $adapt_cfg P >solverlog") == 0 or die "adapt failed: $?";
system("adapt $adapt_cfg N >solverlogneg") == 0 or die "adapt failed: $?";
(-s "FSOL.dat" && -s "FSOLNEG.dat") or die "solver failed.\n";
unlink "param";

# Run Nz instances of NRG iteration
for (my $i = 1; $i <= $Nz; $i++) {
  my $z = $i/$Nz;
  system("m4 -DEPS=$epsimp -DZZZ=$z param.loop >param") == 0 or die "m4 failed: $?";
  system("mkdir -p $i") == 0 or die "mkdir failed: $?";
  unlink("$i/DONE"); # in case of reusing instance directory, ensure DONE flag file is cleared first

  if ($mma) {
      chdir $i or die;
      system("cp ../Delta.dat Delta.dat") == 0 or die;
      system("cp ../param param") == 0 or die;
      system("nrginit") == 0 or die "nrginit failed: $?";
  } else {
      system("scripts/instantiate $i") == 0 or die "instantiate failed: $?";
      chdir $i or die;
  }

  if ($local) {
    if (can_run("mynrgrun")) {
      system("mynrgrun") == 0 or die "mynrgrun failed: $?"; # custom wrapper
    } else {
      system("nrg") == 0 or die "nrg failed: $?"; # run executable directly as fall-back
    }
  } else {
    system("subslurm") == 0 or die "subslurm failed: $?";
  }
  chdir ".." or die;
}

# Process the results.
if (-x "scripts/dmft_done") {
    system("scripts/dmft_done") == 0 or die "dmft_done failed: $?";
}
