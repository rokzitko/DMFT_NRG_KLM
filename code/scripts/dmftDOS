#!/usr/bin/env perl
# Calculation of the effective hybridisation function
# Rok Zitko, rok.zitko@ijs.si, 2026

use strict;
use warnings;
use Math::Complex;

my $result_dir = @ARGV ? shift @ARGV : "res";
my $mu_file = @ARGV ? shift @ARGV : "param.mu";
my $re_output = @ARGV ? shift @ARGV : "ReDelta.dat";
my $im_output = @ARGV ? shift @ARGV : "ImDelta.dat";
@ARGV and die "Usage: $0 [result_dir [mu_file [re_output [im_output]]]]\n";

# Read a column from a file
sub readcol {
    my ($filename, $column) = @_;

    my @l;
    open(F, "<$filename") or die "Can't open $filename for reading, stopped";
    while (<F>) {
        chomp;
        my $x = (split)[$column-1];
        push(@l, $x);
    }
    close(F);

    @l
};

my $pi = pi;

# Clipping of Im part of Delta; NRG requires the hybridization funciton Gamma=-Im(Delta) to be strictly positive!
chomp(my $imclip = `getparam clipDelta param.loop`);
if ($imclip eq "") {
  chomp($imclip = `getparam clip param.loop`); # fall back
}
$imclip ne "" or die;
$imclip > 0.0 or die;

print "dmftDOS - imclip=$imclip\n";

# Chemical potential
open(my $mu_fh, "<", $mu_file) or die "Can't open $mu_file for reading, stopped";
my $mu = <$mu_fh>;
close($mu_fh);
defined $mu or die "Chemical potential not found in $mu_file";
chomp($mu);

my $prefix = "$result_dir/";
my @omega = readcol("${prefix}imaw.dat", 1);
my @imG =   readcol("${prefix}imaw.dat", 2);
my @reG =   readcol("${prefix}reaw.dat", 2);
my @imS =   readcol("${prefix}imsigma.dat", 2);
my @reS =   readcol("${prefix}resigma.dat", 2);

scalar(@omega) == scalar(@imG) or die "ImG mesh mismatch.";
scalar(@omega) == scalar(@reG) or die "ReG mesh mismatch.";
scalar(@omega) == scalar(@imS) or die "ImSigma mesh mismatch.";
scalar(@omega) == scalar(@reS) or die "ReSigma mesh mismatch.";

open(R, ">", $re_output) or die;
open(I, ">", $im_output) or die;

my $len = @omega;
for (my $i = 0; $i < $len; $i++) {
    my $o = $omega[$i];
    my $G = $reG[$i] + i * $imG[$i];
    my $sigma = $reS[$i] + i * $imS[$i];
    my $GF = -$pi * $G; # difference between DOS and Im GF !
    Im($sigma) < 0.0 or die; # contract
    Im($GF) < 0.0 or die; # contract

    # G_0^-1 = G^-1_local + Sigma
    my $g01 = 1/$GF + $sigma;

    # Delta(z) = z+mu-G_0^-1
    my $Delta = $o + $mu - $g01;

    my $re = Re($Delta); # stored in ReDelta.dat
    my $im = Im($Delta); # stored in ImDelta.dat

    # Perform ImDelta.dat clipping to ensure hybridization function (Gamma=-ImDelta) is positive (!)
    if ($im > -$imclip) {
        $im = -$imclip;
    }
    $im < 0.0 or die; # contract

    print R "$o $re\n";
    print I "$o $im\n";
}
