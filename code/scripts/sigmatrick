#!/usr/bin/env perl
# Calculate the self-energy and the spectral function via the self-energy trick
# Assumption: the same mesh is used in all files (Delta.dat and various spectra).
# General approach, for QS symmetry type
# Rok Zitko, rok.zitko@ijs.si, 2008-2026

use strict;
use warnings;
use File::Basename qw(dirname);
use File::Spec;
use File::Temp qw(tempfile);
use List::Util qw(min max);
use Math::Complex;
use POSIX qw(isfinite);

my $result_dir = @ARGV ? shift @ARGV : (-d "res" ? "res" : ".");
my $mesh_file = @ARGV ? shift @ARGV
    : ($result_dir eq "." && -s "mesh.used.dat" ? "mesh.used.dat" : "mesh.dat");
my $mu_file = @ARGV ? shift @ARGV
    : ($result_dir eq "." && -s "param.mu.used" ? "param.mu.used" : "param.mu");
my $customfdm_file = @ARGV ? shift @ARGV : "customfdm.avg";
@ARGV and die "Usage: $0 [result_dir [mesh_file [mu_file [customfdm_file]]]]\n";
my @output_temporaries;
END { unlink(grep { defined($_) && (-e $_ || -l $_) } @output_temporaries); }

# $imclip is the "infinitesimal" clipping value for Im(Sigma), to prevent causality violations
my $imclip = parse_number(parameter("clipSigma", "clip"), "clipSigma (or clip) in param.loop");
$imclip > 0.0 or die "clipSigma must be positive\n";

my $mode = lc(parameter("sigmatrick") // "new");
$mode =~ /\A(?:new|new-im|old|new-crossover)\z/
    or die "Invalid sigmatrick=$mode; expected new, new-im, old, or new-crossover\n";
my $reconstruct = $mode eq "new-im" || $mode eq "new-crossover";
my ($w_crossover, $w_width);
if ($mode eq "new-crossover") {
    $w_crossover = parse_number(parameter("w_crossover"), "w_crossover in param.loop");
    $w_width = parse_number(parameter("w_width"), "w_width in param.loop");
    $w_crossover > 0.0 or die "w_crossover must be positive\n";
    $w_width > 1.0 or die "w_width must be greater than one\n";
    print "w_crossover=$w_crossover w_width=$w_width\n";
}
print "sigmatrick - mode=$mode imclip=$imclip\n";

my ($omega, $omega_text) = read_mesh($mesh_file);
if ($reconstruct) {
    @$omega >= 4 or die "$mesh_file must contain at least four rows for Steffen KK\n";
    @$omega % 2 == 0 or die "$mesh_file must contain an even number of rows for KK\n";
    for my $index (0 .. $#$omega) {
        my $opposite = $#$omega - $index;
        my $scale = max(abs($omega->[$index]), abs($omega->[$opposite]), 1.0);
        abs($omega->[$index] + $omega->[$opposite]) <= 1e-10 * $scale
            or die "$mesh_file frequency mesh is not symmetric around zero\n";
    }
}
my %spectra;
my @components = qw(imG imF);
push(@components, qw(reG reF)) if $mode ne "new-im";
push(@components, "imI") if $mode ne "old";
push(@components, "reI") if $mode eq "new";
for my $name (@components) {
    my $file = "$result_dir/c-$name.dat";
    my ($source_mesh, $values) = read_table($file);
    require_same_mesh($omega, $source_mesh, $file);
    $spectra{$name} = $values;
}

# Eq. (11) already contains the Hartree term through F/G.
my $SigmaH = $mode eq "old" ? 0.0 : command_number(
    "SigmaHd in $customfdm_file", "extractcolumn", $customfdm_file, "SigmaHd",
);

# Chemical potential
my $mu = read_scalar($mu_file);
print "mu=$mu\n";

# ReDelta is the causal reconstruction of authoritative Gamma plus param.eps.

my $gamma_file = $result_dir eq "." && -s "Delta.used.dat"
    ? "Delta.used.dat"
    : (-s "$result_dir/Delta.used.dat" ? "$result_dir/Delta.used.dat" : "$result_dir/Delta.dat");
my $redelta_file = $result_dir eq "." && -s "ReDelta.used.dat"
    ? "ReDelta.used.dat" : "$result_dir/ReDelta.dat";
my ($gamma_mesh, $gamma) = read_table($gamma_file);
my ($redelta_mesh, $redelta) = read_table($redelta_file);
require_same_mesh($omega, $gamma_mesh, $gamma_file);
require_same_mesh($omega, $redelta_mesh, $redelta_file);
for my $index (0 .. $#$gamma) {
    $gamma->[$index] >= 0.0
        or die "$gamma_file contains negative Gamma at row " . ($index + 1) . "\n";
}
my @imdelta = map { -$_ } @$gamma;

my $pi = pi;
# Finish validation and calculation before replacing any published output.
my (@resigma, @imsigma, @self);
for my $index (0 .. $#$omega) {
    my $weight = $mode eq "new-im" ? 0.0 : 1.0;
    if ($mode eq "new-crossover") {
        my $r = abs($omega->[$index]);
        if ($r <= $w_crossover / $w_width) {
            $weight = 0.0;
        } elsif ($r >= $w_crossover * $w_width) {
            $weight = 1.0;
        } else {
            # Quintic smoothstep in log frequency: C2 joins and 50:50 at w_crossover.
            my $t = 0.5 * (1.0 + (log($r) - log($w_crossover)) / log($w_width));
            $t = min(1.0, max(0.0, $t));
            $weight = min(1.0, max(0.0, $t**3 * (10.0 + $t * (-15.0 + 6.0 * $t))));
        }
    }

    my ($re, $im) = (0.0, 0.0);
    if ($weight > 0.0) {
        my $G = -$pi * (
            $spectra{reG}->[$index] + i * $spectra{imG}->[$index]
        );
        my $g_magnitude = abs($G);
        isfinite($g_magnitude) && $g_magnitude > 0.0
            or die "G is zero or non-finite at row " . ($index + 1) . "\n";
        my $F = -$pi * (
            $spectra{reF}->[$index] + i * $spectra{imF}->[$index]
        );
        my $sigma;
        if ($mode eq "old") {
            $sigma = $F / $G; # Kugler Eq. (11).
        } else {
            # Only Im I is needed when Re Sigma will be reconstructed by KK.
            my $I = -$pi * (
                ($mode eq "new" ? $spectra{reI}->[$index] : 0.0)
                + i * $spectra{imI}->[$index]
            );
            $sigma = $SigmaH + $I - $F / $G * $F; # Eq. (12).
        }
        $re = Re($sigma);
        $im = $weight * Im($sigma);
    }
    if ($weight < 1.0) {
        my $imG = -$pi * $spectra{imG}->[$index];
        my $imF = -$pi * $spectra{imF}->[$index];
        my $imI = -$pi * $spectra{imI}->[$index];
        isfinite($imG) && $imG != 0.0
            or die "Im G is zero or non-finite at row " . ($index + 1) . "\n";
        # Eq. (15), omitting the correction in Eq. (30). Divide before squaring.
        $im += (1.0 - $weight) * ($imI - $imF / $imG * $imF);
    }
    isfinite($re) && isfinite($im)
        or die "Self-energy is non-finite at row " . ($index + 1) . "\n";
    $im = -$imclip if $im > -$imclip;
    $im < 0.0 or die "Self-energy is not causal at row " . ($index + 1) . "\n";
    push(@resigma, $re);
    push(@imsigma, $im);
}

if ($reconstruct) {
    my @kk_files;
    for my $part (qw(im re)) {
        my ($fh, $file) = tempfile(".sigmatrick-$part.tmp.XXXXXX", DIR => $result_dir);
        push(@output_temporaries, $file);
        close($fh) or die "Can't close $file: $!\n";
        push(@kk_files, $file);
    }
    # KK transforms the same clipped, actual Im Sigma that will be published.
    write_table($kk_files[0], $omega_text, \@imsigma);
    system("kk", "-v", "--interpolation", "steffen", "--algorithm", "analytic", @kk_files) == 0
        or die "Self-energy Steffen KK reconstruction failed: $?\n";
    my ($re_mesh, $dynamic_real) = read_table($kk_files[1]);
    require_same_mesh($omega, $re_mesh, "Self-energy KK output");
    @resigma = map {
        my $value = $_ + $SigmaH;
        isfinite($value) or die "Self-energy overflow after adding SigmaHd\n";
        $value;
    } @$dynamic_real;
}

for my $index (0 .. $#$omega) {
    my $sigma_clipped = $resigma[$index] + i * $imsigma[$index];
    my $delta = $redelta->[$index] + i * $imdelta[$index];
    my $denominator = $omega->[$index] + $mu - $delta - $sigma_clipped;
    my $denominator_magnitude = abs($denominator);
    isfinite($denominator_magnitude) && $denominator_magnitude > 0.0
        or die "Dyson denominator is zero or non-finite at row " . ($index + 1) . "\n";
    my $gf = 1.0 / $denominator;
    my $aw = -1.0 / $pi * Im($gf);
    isfinite($aw) && $aw > 0.0
        or die "Reconstructed spectral function is invalid at row " . ($index + 1) . "\n";

    push(@self, $aw);
}

publish_tables(
    $omega_text,
    ["$result_dir/c-self.dat", \@self],
    ["$result_dir/imsigma.dat", \@imsigma],
    ["$result_dir/resigma.dat", \@resigma],
);

sub parameter {
    my @names = @_;
    open(my $fh, "<", "param.loop") or die "Can't read param.loop: $!\n";
    my %values;
    while (<$fh>) {
        for my $name (@names) {
            push(@{$values{$name}}, $1) if /^\s*\Q$name\E\s*=\s*(.*?)\s*$/;
        }
    }
    close($fh) or die "Can't close param.loop: $!\n";
    for my $name (@names) {
        next unless exists($values{$name});
        @{$values{$name}} == 1 or die "Duplicate $name in param.loop\n";
        return $values{$name}[0];
    }
    return undef;
}

sub command_number {
    my ($context, @command) = @_;
    open(my $fh, "-|", @command) or die "Can't run $command[0]: $!\n";
    local $/;
    my $text = <$fh>;
    close($fh) or die "$command[0] failed: $?\n";
    defined($text) or die "$context was not found\n";
    return parse_number($text, $context);
}

sub read_scalar {
    my ($file) = @_;
    open(my $fh, "<", $file) or die "Can't read $file: $!\n";
    local $/;
    my $text = <$fh>;
    close($fh) or die "Can't close $file: $!\n";
    return parse_number($text, $file);
}

sub parse_number {
    my ($text, $context) = @_;
    my $number = qr/[+-]?(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][+-]?\d+)?/;
    defined($text) && $text =~ /\A\s*($number)\s*\z/
        or die "Invalid numeric value in $context\n";
    my $value = 0.0 + $1;
    isfinite($value) or die "Non-finite numeric value in $context\n";
    return $value;
}

sub read_mesh {
    my ($file) = @_;
    open(my $fh, "<", $file) or die "Can't read $file: $!\n";
    my (@mesh, @mesh_text);
    my $line_number = 0;
    while (<$fh>) {
        ++$line_number;
        next if /^\s*(?:#.*)?$/;
        my @fields = split;
        @fields == 2 or die "Expected two columns in $file at line $line_number\n";
        my $frequency = parse_number($fields[0], "$file at line $line_number");
        @mesh && $frequency <= $mesh[-1]
            and die "Frequency mesh is not strictly increasing in $file at line $line_number\n";
        push(@mesh, $frequency);
        push(@mesh_text, $fields[0]);
    }
    close($fh) or die "Can't close $file: $!\n";
    @mesh or die "No data rows in $file\n";
    return (\@mesh, \@mesh_text);
}

sub read_table {
    my ($file) = @_;
    open(my $fh, "<", $file) or die "Can't read $file: $!\n";
    my (@mesh, @values, @mesh_text);
    my $line_number = 0;
    while (<$fh>) {
        ++$line_number;
        next if /^\s*(?:#.*)?$/;
        my @fields = split;
        @fields == 2 or die "Expected two columns in $file at line $line_number\n";
        my $frequency = parse_number($fields[0], "$file at line $line_number");
        my $value = parse_number($fields[1], "$file at line $line_number");
        @mesh && $frequency <= $mesh[-1]
            and die "Frequency mesh is not strictly increasing in $file at line $line_number\n";
        push(@mesh, $frequency);
        push(@values, $value);
        push(@mesh_text, $fields[0]);
    }
    close($fh) or die "Can't close $file: $!\n";
    @mesh or die "No data rows in $file\n";
    return (\@mesh, \@values, \@mesh_text);
}

sub require_same_mesh {
    my ($reference, $candidate, $context) = @_;
    @$reference == @$candidate or die "$context mesh-size mismatch\n";
    for my $index (0 .. $#$reference) {
        my $scale = max(abs($reference->[$index]), abs($candidate->[$index]), 1.0);
        abs($reference->[$index] - $candidate->[$index]) <= 1e-12 * $scale
            or die "$context frequency mismatch at row " . ($index + 1) . "\n";
    }
}

sub publish_tables {
    my ($mesh, @outputs) = @_;
    my (%targets, @publications);
    for my $output (@outputs) {
        my ($path, $values) = @$output;
        @$mesh == @$values or die "Output length mismatch for $path\n";
        my $target = output_target($path);
        -d dirname($target) or die "Output directory does not exist for $path\n";
        !-d $target or die "Output target is a directory: $path\n";
        my $absolute = File::Spec->rel2abs($target);
        $targets{$absolute}++ and die "Self-energy outputs must be distinct files\n";
        my $temporary = "$target.tmp.$$";
        unlink($temporary);
        push(@output_temporaries, $temporary);
        push(@publications, [$temporary, $target, $values]);
    }

    write_table($_->[0], $mesh, $_->[2]) for @publications;
    for my $publication (@publications) {
        my ($temporary, $target) = @$publication;
        rename($temporary, $target) or die "Can't replace $target: $!\n";
    }
}

sub output_target {
    my ($path) = @_;
    return $path unless -l $path;
    my $target = readlink($path);
    defined($target) or die "Can't read output symlink $path: $!\n";
    return $target if File::Spec->file_name_is_absolute($target);
    return File::Spec->catfile(dirname($path), $target);
}

sub write_table {
    my ($file, $mesh, $values) = @_;
    open(my $fh, ">", $file) or die "Can't write $file: $!\n";
    for my $index (0 .. $#$mesh) {
        print {$fh} "$mesh->[$index] $values->[$index]\n"
            or die "Can't write $file: $!\n";
    }
    close($fh) or die "Can't close $file: $!\n";
}
