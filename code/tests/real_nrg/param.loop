[extra]
eps1=EPS
U1=0
spin=1/2
JK=0.4
B=0

[dmft]
Nz=2

clip=1e-5
clipDelta=1e-6
clipSigma=1e-12

goal=1
occupancy_mode=accurate
maxdx=0.05
under=0.5
occupancy_solve_tol=5e-3
occupancy_mu_tol=1e-8
occupancy_weight_tol=5e-3
occupancy_integ_epsabs=1e-9
occupancy_integ_epsrel=1e-8
occupancy_maxeval=12
mucontrol=std

mixing=linear
alpha=0.5

conveps=1e-8
convwindow=2
miniter=2
maxiter=2

opt_delta=1e-2
opt_mindx=1e-8
opt_ymin=1e-4
track=false

[param]
xmax=30
adapt=false
prec=1000
polarized=false

symtype=QS
model=model.m
fixeps=1e-10

Lambda=2
Nmax=26
keepmin=128
keepenergy=8
keep=512

discretization=Z
band=asymode
density_interpolation=steffen
bandrescale=10
dos=Delta.dat
z=ZZZ

strategy=kept
ops=A_d self_d n_d n_d_ud Himp Hpot SigmaHd SdSk
specd=A_d-A_d self_d-A_d self_d-self_d

prec_xy=12

fdm=true
fdmexpv=true

broaden=false
savebins=true
bins=100

T=0.01

broaden_max=40
broaden_ratio=1.05
broaden_min=1e-4
broaden_alpha=0.3
broaden_gamma=0.2

width_custom=20
prec_custom=14

done=true
lastalloverride=true
data_has_rescaled_energies=false
