#!/usr/bin/env python3
"""Generate the normalized semicircular density of states in DOS.dat."""

import math
from pathlib import Path
import re
import subprocess
import sys


INTERPOLATION = "cspline"
NORMALIZATION_TOLERANCE = 1e-10
OUTPUT = Path("DOS.dat")
SUM_PATTERN = re.compile(
    r"(?m)^Sum=([+-]?(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][+-]?\d+)?)\s*$"
)


def write_dos(normalization):
    rows = []
    for index in range(-1300, 1301):
        epsilon = index / 1000
        rho = 0.0
        if abs(index) <= 1000:
            rho = 2.0 / math.pi * math.sqrt(max(0.0, 1.0 - epsilon**2))
        rows.append(f"{epsilon:.3f}\t{rho / normalization:.17g}\n")
    OUTPUT.write_text("".join(rows), encoding="ascii")


def hilb_normalization():
    command = [
        "hilb",
        "-v",
        "-i",
        INTERPOLATION,
        "--gsl-error-policy",
        "fail",
        "-d",
        str(OUTPUT),
        "0",
        "1",
    ]
    try:
        result = subprocess.run(
            command,
            capture_output=True,
            text=True,
            check=False,
        )
    except OSError as exc:
        raise RuntimeError(f"unable to run hilb: {exc}") from exc

    if result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip()
        raise RuntimeError(detail or f"hilb exited with status {result.returncode}")

    sums = SUM_PATTERN.findall(result.stdout)
    if len(sums) != 1:
        raise RuntimeError("unable to determine the DOS normalization from hilb output")
    normalization = float(sums[0])
    if not math.isfinite(normalization) or normalization <= 0.0:
        raise RuntimeError("hilb reported an invalid DOS normalization")
    return normalization


def main():
    write_dos(1.0)
    write_dos(hilb_normalization())

    normalization = hilb_normalization()
    if abs(normalization - 1.0) > NORMALIZATION_TOLERANCE:
        raise RuntimeError(f"DOS normalization check failed: {normalization:.17g}")
    print(f"DOS normalization ({INTERPOLATION}) = {normalization:.17g}")


if __name__ == "__main__":
    try:
        main()
    except (OSError, RuntimeError) as exc:
        print(f"mkDOS: {exc}", file=sys.stderr)
        raise SystemExit(1) from exc
