#!/usr/bin/env python3
"""Generate the normalized semicircular density of states in DOS.dat."""

import math
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile

from bethe_tables import bethe_rows, publication_mode


INTERPOLATION = "steffen"
NORMALIZATION_TOLERANCE = 1e-12
OUTPUT = Path("DOS.dat")
INTEGRAL_PATTERN = re.compile(
    r"(?m)^\s*dos\.integral="
    r"([+-]?(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][+-]?\d+)?)\s*$"
)
EXPECTED_ALGORITHM = "algorithm=analytic"
WARNING_PATTERN = re.compile(r"\bwarning\b", re.IGNORECASE)


def write_dos(path, normalization):
    rows = [
        f"{epsilon:.17g}\t{rho / normalization:.17g}\n"
        for epsilon, rho, _ in bethe_rows()
    ]
    path.write_text("".join(rows), encoding="ascii")


def hilb_normalization(path):
    command = [
        "hilb",
        "-v",
        "-i",
        INTERPOLATION,
        "--algorithm",
        "analytic",
        "--gsl-error-policy",
        "warn",
        "-d",
        str(path),
        "0",
        "1",
    ]
    try:
        result = subprocess.run(
            command,
            capture_output=True,
            text=True,
            check=False,
        )
    except OSError as exc:
        raise RuntimeError(f"unable to run hilb: {exc}") from exc

    if result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip()
        raise RuntimeError(detail or f"hilb exited with status {result.returncode}")

    for line in result.stderr.splitlines():
        if WARNING_PATTERN.search(line):
            print(line, file=sys.stderr)
    if EXPECTED_ALGORITHM not in result.stderr:
        raise RuntimeError("hilb did not select the analytic tabulated backend")
    integrals = INTEGRAL_PATTERN.findall(result.stderr)
    if len(integrals) != 1:
        raise RuntimeError("unable to determine the DOS normalization from hilb output")
    normalization = float(integrals[0])
    if not math.isfinite(normalization) or normalization <= 0.0:
        raise RuntimeError("hilb reported an invalid DOS normalization")
    return normalization


def main():
    mode = publication_mode(OUTPUT)
    descriptor, temporary_name = tempfile.mkstemp(
        prefix=f".{OUTPUT.name}.", dir=OUTPUT.parent, text=True
    )
    os.close(descriptor)
    temporary = Path(temporary_name)
    try:
        write_dos(temporary, 1.0)
        write_dos(temporary, hilb_normalization(temporary))

        normalization = hilb_normalization(temporary)
        if abs(normalization - 1.0) > NORMALIZATION_TOLERANCE:
            raise RuntimeError(
                f"DOS normalization check failed: {normalization:.17g}"
            )
        os.chmod(temporary, mode)
        os.replace(temporary, OUTPUT)
    finally:
        try:
            temporary.unlink()
        except FileNotFoundError:
            pass
    print(f"DOS normalization ({INTERPOLATION}) = {normalization:.17g}")


if __name__ == "__main__":
    try:
        main()
    except (OSError, RuntimeError) as exc:
        print(f"mkDOS: {exc}", file=sys.stderr)
        raise SystemExit(1) from exc
