#!/usr/bin/env python3
"""Generate the Bethe-lattice transport function in PHI.dat."""

import math
from pathlib import Path
import sys


OUTPUT = Path("PHI.dat")


def main():
    rows = []
    for index in range(-1300, 1301):
        epsilon = index / 1000
        phi = 0.0
        if abs(index) <= 1000:
            phi = 2.0 / math.pi * max(0.0, 1.0 - epsilon**2) ** 1.5
        rows.append(f"{epsilon:.3f}\t{phi:.17g}\n")
    OUTPUT.write_text("".join(rows), encoding="ascii")


if __name__ == "__main__":
    try:
        main()
    except OSError as exc:
        print(f"mkPHI: unable to write {OUTPUT}: {exc}", file=sys.stderr)
        raise SystemExit(1) from exc
