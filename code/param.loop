[extra]
# Impurity level
eps1=EPS

# Hubbard parameter
U1=0

# Kondo parameters
spin=1/2
JK=0.4
B=0

[dmft]
# Number of discretization grids for NRG
Nz=4

# Clipping values for ImDelta, ImSigma, ImG (+default fallback)
clip=1e-5
clipDelta=1e-6
clipSigma=1e-12
clipG=1e-14

# Conduction band occupancy
goal=0.8
maxdx=0.05
under=0.5

# Linear mixing parameter for Delta.dat
alpha=0.5

# Accuracy goal for the spectral function (integrated
# difference between two iterations)
conveps=1e-8
miniter=10
maxiter=100

# Mesh optimization parameters
# - Precision goal for linearly interpolated values
opt_delta=1e-3
# - Smallest interpoint distance in the mesh
opt_mindx=1e-10
# - Lowest value of y (|ImDelta|) for allowing insertion of extra points
opt_ymin=1e-5

# Track iteration by keeping snapshots in dmft/
track=false

[param]
xmax=25
adapt=false
prec=1000
polarized=false

symtype=QS
model=model.m

fixeps=1e-10

Lambda=2.0
# Nmax must be set manually!
Nmax=54
#Tmin=1e-7
keepmin=500
keepenergy=8
keep=10000

discretization=Z
band=asymode
# Note that Delta.dat needs to be fully contained in [-bandrescale:bandrescale] interval. Checked by scripts/checkDelta.
bandrescale=10
dos=Delta.dat

z=ZZZ

strategy=kept
ops=A_d self_d n_d n_d_ud Himp Hpot SigmaHd O_d SdSk
specd=A_d-A_d self_d-A_d self_d-self_d O_d-O_d

prec_xy=12

mmadebug=2

fdm=true
fdmexpv=true

broaden=false
savebins=true
bins=500

T=0.01

# There are benefits in taking broaden_max large. It must be (much) larger than bandrescale.
broaden_max=40
broaden_ratio=1.01
# Note: choose broaden_min << T
broaden_min=1e-7
broaden_alpha=0.3
broaden_gamma=0.2

width_custom=20
prec_custom=14

done=true
lastalloverride=true

data_has_rescaled_energies=false
