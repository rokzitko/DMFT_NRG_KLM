#!/usr/bin/env python3
"""Generate a normalized edge-refined asymmetric DOS in DOS.dat."""

import math
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile


OUTPUT = Path("DOS.dat")
INTERPOLATION = "steffen"
NORMALIZATION_TOLERANCE = 1e-12
NUMBER = re.compile(r"[+-]?(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][+-]?\d+)?")


def asymmetric_rows():
    band_center = 0.4
    lower_edge = band_center - 1.0
    upper_edge = band_center + 1.0
    rows = [
        (-1.6 + (lower_edge + 1.6) * index / 300, 0.0)
        for index in range(300)
    ]
    for index in range(2001):
        theta = -math.pi / 2 + math.pi * index / 2000
        relative_energy = math.sin(theta)
        epsilon = band_center + relative_energy
        if index in (0, 2000):
            epsilon = lower_edge if index == 0 else upper_edge
            rho = 0.0
        else:
            rho = (
                2.0
                / math.pi
                * math.sqrt(max(0.0, 1.0 - relative_energy * relative_energy))
                * (1.0 - 0.9 * relative_energy)
            )
        rows.append((epsilon, rho))
    rows.extend(
        (
            upper_edge + (1.6 - upper_edge) * index / 300,
            0.0,
        )
        for index in range(1, 301)
    )
    return rows


def write_dos(path, normalization):
    path.write_text(
        "".join(
            f"{epsilon:.17g}\t{rho / normalization:.17g}\n"
            for epsilon, rho in asymmetric_rows()
        ),
        encoding="ascii",
    )


def represented_normalization(path):
    command = [
        "integ",
        "--interpolation",
        INTERPOLATION,
        "--total",
        "--",
        str(path),
    ]
    try:
        result = subprocess.run(command, capture_output=True, text=True, check=False)
    except OSError as exc:
        raise RuntimeError(f"unable to run integ: {exc}") from exc
    if result.stderr:
        print(result.stderr, file=sys.stderr, end="")
    if result.returncode != 0:
        detail = result.stdout.strip() or f"exit status {result.returncode}"
        raise RuntimeError(f"integ failed: {detail}")
    fields = result.stdout.split()
    if len(fields) != 1 or NUMBER.fullmatch(fields[0]) is None:
        raise RuntimeError("integ returned an invalid normalization")
    normalization = float(fields[0])
    if not math.isfinite(normalization) or normalization <= 0.0:
        raise RuntimeError("integ returned an invalid normalization")
    return normalization


def publication_mode(path):
    try:
        return path.stat().st_mode & 0o777
    except FileNotFoundError:
        mask = os.umask(0)
        os.umask(mask)
        return 0o666 & ~mask


def main():
    mode = publication_mode(OUTPUT)
    descriptor, temporary_name = tempfile.mkstemp(
        prefix=f".{OUTPUT.name}.", dir=OUTPUT.parent, text=True
    )
    os.close(descriptor)
    temporary = Path(temporary_name)
    try:
        write_dos(temporary, 1.0)
        write_dos(temporary, represented_normalization(temporary))
        normalization = represented_normalization(temporary)
        if abs(normalization - 1.0) > NORMALIZATION_TOLERANCE:
            raise RuntimeError(
                f"DOS normalization check failed: {normalization:.17g}"
            )
        os.chmod(temporary, mode)
        os.replace(temporary, OUTPUT)
    finally:
        try:
            temporary.unlink()
        except FileNotFoundError:
            pass
    print(f"DOS normalization ({INTERPOLATION}) = {normalization:.17g}")


if __name__ == "__main__":
    try:
        main()
    except (OSError, RuntimeError) as exc:
        print(f"mkDOS: {exc}", file=sys.stderr)
        raise SystemExit(1) from exc
