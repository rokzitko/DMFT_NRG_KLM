#!/bin/bash
set -e

# Ensure that param.eps contains the band energy (average energy of DOS.dat)
# This information about the shift needs to be supplied to the NRG separately,
# because Gamma=-ImDelta determines only the dynamic part. The causal real part
# is defined as kk[ImDelta]+param.eps.
# Rok Zitko, rok.zitko@ijs.si, Aug 2026

temporary="param.eps-bubble.tmp.$$"
trap 'rm -f "$temporary"' EXIT

bubble --gsl-error-policy warn --workspace-limit 1000 \
  --interpolation steffen --phi-interpolation steffen \
  -k 6 -a 1e-9 -r 1e-8 -s 1e-12 -e 1 -p DOS.dat \
  0 0 0 1e-10 0 DOS.dat DOS.dat >"$temporary"
perl -e '
  use POSIX qw(isfinite);
  local $/;
  my $text = <>;
  my $number = qr/[+-]?(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][+-]?\d+)?/;
  defined($text) && $text =~ /\A\s*($number)\s*\z/ or die "invalid Bubble output\n";
  my $value = 0.0 + $1;
  isfinite($value) or die "non-finite Bubble output\n";
' "$temporary"
mv "$temporary" param.eps-bubble
trap - EXIT
