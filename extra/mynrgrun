#!/bin/bash
set -euo pipefail

nrthread=8
export OMP_NUM_THREADS="$nrthread"
export MKL_NUM_THREADS="$nrthread"
tmppath=/work/zitko/work/nrg
mkdir -p "$tmppath"
MYTMPDIR=$(mktemp -d "$tmppath/work.XXXXXXXXXX")

cleanup() {
  local status=$?
  trap - EXIT
  rm -rf -- "$MYTMPDIR" || status=$?
  exit "$status"
}
trap cleanup EXIT

echo "MYTMPDIR=$MYTMPDIR"
nrg -w "$MYTMPDIR" 2>log2 | tee log
